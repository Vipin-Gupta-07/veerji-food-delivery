{
  "version": 2,
  "buildCommand": "npm run build",
  "devCommand": "npm run dev",
  "installCommand": "npm install",
  "framework": "nextjs",
  "env": {
    "MONGODB_URI": "@mongodb-uri",
    "JWT_SECRET": "@jwt-secret",
    "NEXT_PUBLIC_APP_URL": "@app-url"
  },
  "functions": {
    "app/api/**": {
      "maxDuration": 30
    },
    "app/api/scrape-swiggy/**": {
      "maxDuration": 60
    }
  }
}
