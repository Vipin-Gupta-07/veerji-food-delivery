# MongoDB Connection
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/veerji-food-delivery?retryWrites=true&w=majority

# JWT Secret (generate a strong random string)
JWT_SECRET=your_super_secret_jwt_key_here_min_32_chars

# Next.js Public URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Admin Credentials (for initial setup)
ADMIN_EMAIL=admin@veerji.com
ADMIN_PASSWORD=Admin@123456

# App Config
NODE_ENV=development
NEXT_PUBLIC_RESTAURANT_NAME="Veer Ji Malai Chaap Wale"
NEXT_PUBLIC_RESTAURANT_PHONE="+91-9876543210"
